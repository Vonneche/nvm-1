#!/usr/bin/env bash

set -e

SUITE="${1:?test suite is required}"
TEST_SHELL="${2:?test shell is required}"
SUITE_DIR="test/${SUITE}"

[ -d "${SUITE_DIR}" ] || {
  echo "Test suite not found: ${SUITE}" >&2
  exit 1
}

run_hook() {
  HOOK_DIR=$1
  HOOK=$2
  [ -f "${HOOK_DIR}/${HOOK}" ] || return 0
  (
    cd "${HOOK_DIR}" || exit 1
    "${TEST_SHELL}" "./${HOOK}"
  )
}

run_test() {
  TEST_FILE=$1
  TEST_DIR=$(dirname "${TEST_FILE}")
  run_hook "${SUITE_DIR}" setup_dir
  run_hook "${SUITE_DIR}" setup
  if [ "${TEST_DIR}" != "${SUITE_DIR}" ]; then
    run_hook "${TEST_DIR}" setup_dir
    run_hook "${TEST_DIR}" setup
  fi
  (
    cd "${TEST_DIR}" || exit 1
    "${TEST_SHELL}" "./$(basename "${TEST_FILE}")"
  )
  STATUS=$?
  if [ "${TEST_DIR}" != "${SUITE_DIR}" ]; then
    run_hook "${TEST_DIR}" teardown
    run_hook "${TEST_DIR}" teardown_dir
  fi
  run_hook "${SUITE_DIR}" teardown
  run_hook "${SUITE_DIR}" teardown_dir
  return "${STATUS}"
}

while IFS= read -r TEST_FILE; do
  if [ -x "${TEST_FILE}" ]; then
    echo "Running ${TEST_FILE}"
    run_test "${TEST_FILE}" || exit 1
  fi
done < <(find "${SUITE_DIR}" -type f ! -name setup ! -name setup_dir ! -name teardown ! -name teardown_dir)
